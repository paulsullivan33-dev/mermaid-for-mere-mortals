flowchart LR
    A[Rectangle - a step]
    B(Rounded rectangle - an event)
    C([Stadium - a start or end])
    D{Diamond - a decision}
    E[[Subroutine - a named process]]
    F[(Database - stored data)]
    G((Circle - a connector))
    H>Flag - a note]
    A --> B --> C --> D --> E --> F --> G --> H
